# ==============================================================================
# DAR — DarGlobal AI Property Assistant Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your secrets.
# NEVER commit .env to version control.
# ==============================================================================

# Required: OpenRouter API key for LLM chat completion
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Server host and port
HOST=0.0.0.0
PORT=7860

# Optional: Candidate OpenRouter model override
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional: Environment mode (development / production)
ENVIRONMENT=production
